TEXTBEE_SEND_TIMEOUT_MS=
# How many proxy hops in front of the app to trust when deriving the client
# IP (see app.ts "trust proxy"). 1 is correct for Cloudflare -> origin.
# Set 0 (or false) when the app is reached directly: with a hop count of 0
# the x-forwarded-for header is ignored entirely, so a caller cannot spoof
# its address. The rate limiters and the audit trail key on this value.
TRUST_PROXY=
UPLOAD_DIR=
VITE_API_URL=
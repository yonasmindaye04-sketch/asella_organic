ADMIN_ROLE=
ADMIN_USERNAME=
ALLOWED_ORIGINS=
# Extra origins allowed to call the API cross-origin OUTSIDE production,
# named one by one (comma-separated). Used for the Telegram Mini App tunnel:
#
#   PREVIEW_ORIGINS=https://<random-word>.<random-word>.trycloudflare.com
#
# The origin of TELEGRAM_MINIAPP_URL is trusted automatically outside
# production. Wildcard hostnames are NOT accepted: see ASE-2026-011.
PREVIEW_ORIGINS=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=
DB_USER=
FRONTEND_URL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=

# ── JWT secrets ──────────────────────────────────────────────────────────────
# REQUIRED in every non-test environment. The application refuses to start
# without this; there is no default value (a published fallback would let
# anyone forge tokens — see security/findings/REGISTER.md ASE-2026-003).
#
# Minimum length: 32 ASCII characters.
#
# Generate a new one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotation: to roll the secret without invalidating in-flight sessions, set
# JWT_SECRET to the NEW value and JWT_SECRET_PREVIOUS to the OLD value. The
# application accepts tokens signed with either, but always signs new
# tokens with the current value. After the longest access-token TTL has
# elapsed (default 1 hour), unset JWT_SECRET_PREVIOUS to retire the old
# secret entirely.
JWT_SECRET=
JWT_SECRET_PREVIOUS=

MAX_FILE_SIZE_MB=
PUBLIC_URL=
REDIS_URL=
RETENTION_YEARS=
SMSETHIOPIA_API_KEY=
SMS_DISPATCH_BATCH_SIZE=
SMS_DISPATCH_ENABLED=
SMS_DISPATCH_INTERVAL_MS=
SMS_MAX_CAMPAIGN_COST_ETB=
SMS_MAX_DAILY_COST_ETB=
SMS_MAX_PER_ORDER=
SMS_PROVIDER=
SMS_SENDER_LABEL=
SMS_SEND_TIMEOUT_MS=
SMS_STATUS_COOLDOWN_MINUTES=
SMTP_FROM=

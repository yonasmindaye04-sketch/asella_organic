# ═══════════════════════════════════════════════════════════════════
# .env.example
# Asella Organic — Environment Configuration Template
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill every value  (NEVER leave placeholders in production)
#   3. Set permissions:  chmod 600 .env
#   4. Never commit:     make sure .env is in .gitignore
#
# GENERATE SECRETS (run in terminal):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
TRUST_PROXY=1

# ── Database (MySQL) ─────────────────────────────────────────────────
# On Yegara/DirectAdmin: get these from DirectAdmin → MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Optional: full connection string (used by some ORMs)
# DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME

# ── Redis (Rate Limiting) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────
# Must be at least 64 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_128_CHAR_RANDOM_HEX_STRING

# Admin User Setup (used by backend/create-admin.js)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
ADMIN_FULL_NAME="System Administrator"
ADMIN_ROLE=admin

# ── CORS / Frontend ──────────────────────────────────────────────────
# No trailing slash. Comma-separate multiple origins if needed.
# FRONTEND_URL is a deprecated fallback for ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=https://asellaorganic.com,https://www.asellaorganic.com

# ── Telegram Bot ─────────────────────────────────────────────────────
# Get BOT_TOKEN from @BotFather on Telegram
# Get Chat IDs from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_DELIVERY_GROUP_ID=your_delivery_group_chat_id
TELEGRAM_VENDOR_CHAT_ID=your_vendor_chat_id

# Public HTTPS base URL of THIS backend (no trailing slash).
# Used to build the webhook URL. Set to your tunnel URL when testing locally,
# e.g. https://a1b2c3d4.ngrok-free.app
PUBLIC_URL=

# Public HTTPS URL of the Mini App FRONTEND page (must start with https://).
# The Mini App is a standalone document (frontend/tma.html) that boots without
# the website router, Redux or dashboard routes. Either /tma or /tma.html works;
# both are rewritten to the standalone entry by .htaccess and Vite.
# Route the tunnel to the frontend dev server (5173) so the Vite /api proxy
# forwards API calls to the backend.
TELEGRAM_MINIAPP_URL=

# ── Google Sheets (optional — for order mirroring) ───────────────────
# Leave empty to disable Google Sheets integration
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── SMS (SMSEthiopia) ────────────────────────────────────────────────
# Self-service signup: https://smsethiopia.com/#/auth/sign-up
# Then Console -> API Keys -> generate. 100 free test SMS on signup.
#
# The API authenticates with a `KEY` request header. There is no Bearer
# token and no username/password variant — smsethiopia.com publishes a
# note specifically warning that this is commonly gotten wrong.
SMSETHIOPIA_API_KEY=

# Display label only. The v1 API accepts just { msisdn, text } — there is
# NO sender field in the request body. Alphanumeric sender IDs are a
# dashboard account setting and must be registered there.
SMS_SENDER_LABEL=Asella Organic

# Set to "false" to hold messages in the queue on a box that has a
# credential but must not dispatch (staging, demos).
SMS_DISPATCH_ENABLED=true

# Dispatcher tuning.
SMS_SEND_TIMEOUT_MS=10000
SMS_DISPATCH_INTERVAL_MS=2000
SMS_DISPATCH_BATCH_SIZE=25

# Cost ceilings in ETB. Per-campaign can be overridden by an operator with
# an explicit confirmation; per-day cannot.
# At 0.10-0.45 ETB/segment, 2000 ETB is roughly 4,400-20,000 segments.
SMS_MAX_CAMPAIGN_COST_ETB=2000
SMS_MAX_DAILY_COST_ETB=3000

# Status-churn guard: never repeat the same status for the same order inside
# this window, and cap total messages per order lifetime.
SMS_STATUS_COOLDOWN_MINUTES=120
SMS_MAX_PER_ORDER=4

# ── Email (SMTP) ─────────────────────────────────────────────────────
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Asella Organic" <your_email@gmail.com>

# ── Cloudinary (optional — for CDN image serving) ─────────────────────
# Get these from https://cloudinary.com/console
# When set, uploaded images are served as WebP/AVIF with responsive sizing
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# Alternative: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── File Uploads ─────────────────────────────────────────────────────
# On Yegara: /home/your_cpanel_username/uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# ── Data Retention ───────────────────────────────────────────────────
# How many years to keep identifiable customer data
RETENTION_YEARS=2
